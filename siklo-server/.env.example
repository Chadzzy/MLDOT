# SikLo backend configuration. Copy to `.env` and edit.
# Defaults are MOCK everywhere so the server + tests run with no weights/network.

# ---- Backend selection ------------------------------------------------------
# stt: mock | sensevoice | qwen3asr
STT_BACKEND=mock
# mt:  mock | qwen
MT_BACKEND=mock
# tts: mock | edge | cosyvoice
TTS_BACKEND=mock

# ---- Tier A example (uncomment to run the real laptop/demo stack) ----------
# STT_BACKEND=sensevoice     # requires requirements-tier-a.txt + ffmpeg
# MT_BACKEND=qwen            # requires Ollama running with the model pulled
# TTS_BACKEND=edge           # requires outbound network to Microsoft

# ---- Tier B example (single GPU; see docker-compose.yml `tier-b` profile) --
# STT_BACKEND=qwen3asr       # requires requirements-tier-b.txt + GPU
# MT_BACKEND=qwen            # + MT_API_STYLE=openai, OLLAMA_URL -> vLLM
# MT_API_STYLE=openai
# OLLAMA_URL=http://vllm:8000
# MT_MODEL=qwen3-8b
# TTS_BACKEND=cosyvoice      # requires CosyVoice on PYTHONPATH + weights

# ---- STT (SenseVoice) -------------------------------------------------------
SENSEVOICE_MODEL=iic/SenseVoiceSmall
SENSEVOICE_DEVICE=cpu

# ---- STT (Qwen3-ASR-1.7B, Tier B) — Apache-2.0 ------------------------------
QWEN3ASR_MODEL=Qwen/Qwen3-ASR-1.7B-hf
QWEN3ASR_DEVICE_MAP=auto

# ---- MT (Qwen via Ollama, or vLLM OpenAI-compat) ---------------------------
# api style: ollama (POST /api/chat) | openai (POST /v1/chat/completions)
MT_API_STYLE=ollama
OLLAMA_URL=http://localhost:11434
MT_MODEL=qwen3:8b
MT_TEMPERATURE=0.3
# MT_API_KEY=not-needed        # only for OpenAI-compatible endpoints

# ---- TTS (edge-tts) ---------------------------------------------------------
EDGE_VOICE_YUE=zh-HK-HiuGaaiNeural
EDGE_VOICE_CMN=zh-CN-XiaoxiaoNeural

# ---- TTS (CosyVoice2, Tier B) -----------------------------------------------
COSYVOICE_YUE_DIR=pretrained_models/Cosyvoice2-Yue
COSYVOICE_CMN_DIR=pretrained_models/CosyVoice2-0.5B
COSYVOICE_PROMPT_WAV=pretrained_models/prompt.wav

# ---- Audio ------------------------------------------------------------------
FFMPEG_BIN=ffmpeg
TARGET_SAMPLE_RATE=16000

# ---- CORS (dev: allow all) --------------------------------------------------
CORS_ORIGINS=*
