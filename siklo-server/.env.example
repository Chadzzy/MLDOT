# SikLo backend configuration. Copy to `.env` and edit.
# Defaults are MOCK everywhere so the server + tests run with no weights/network.

# ---- Backend selection ------------------------------------------------------
# stt: mock | sensevoice
STT_BACKEND=mock
# mt:  mock | qwen
MT_BACKEND=mock
# tts: mock | edge
TTS_BACKEND=mock

# ---- Tier A example (uncomment to run the real laptop/demo stack) ----------
# STT_BACKEND=sensevoice     # requires requirements-tier-a.txt + ffmpeg
# MT_BACKEND=qwen            # requires Ollama running with the model pulled
# TTS_BACKEND=edge           # requires outbound network to Microsoft

# ---- STT (SenseVoice) -------------------------------------------------------
SENSEVOICE_MODEL=iic/SenseVoiceSmall
SENSEVOICE_DEVICE=cpu

# ---- MT (Qwen via Ollama, or vLLM OpenAI-compat) ---------------------------
# api style: ollama (POST /api/chat) | openai (POST /v1/chat/completions)
MT_API_STYLE=ollama
OLLAMA_URL=http://localhost:11434
MT_MODEL=qwen3:8b
MT_TEMPERATURE=0.3
# MT_API_KEY=not-needed        # only for OpenAI-compatible endpoints

# ---- TTS (edge-tts) ---------------------------------------------------------
EDGE_VOICE_YUE=zh-HK-HiuGaaiNeural
EDGE_VOICE_CMN=zh-CN-XiaoxiaoNeural

# ---- Audio ------------------------------------------------------------------
FFMPEG_BIN=ffmpeg
TARGET_SAMPLE_RATE=16000

# ---- CORS (dev: allow all) --------------------------------------------------
CORS_ORIGINS=*
