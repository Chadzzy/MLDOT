  "dependencies": {
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.0.1",
    "prettier": "3.8.1",
    "vite": "8.0.1"
  }
}
